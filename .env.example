# Eva KGDJ — copy to .env (never committed)
# Mode: "supabase" (real backend) or "mock" (in-memory graph from src/mock/graph.json, no auth; for UI work and screenshot tests)
VITE_KGDJ_MODE=mock

# Supabase project (region must be eu-central-1 / Frankfurt — see docs/kgdj/01-architecture-decision.md)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key — safe to ship; every read/write is RLS-checked server-side>
# The kgdj schema must be added to "Exposed schemas" in Project Settings > API.
